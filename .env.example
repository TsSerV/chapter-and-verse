# Copy to .env and fill in your own key. Never commit .env.
CLAUDE_API_TOKEN=sk-ant-...

# Only compose.yaml uses it. Letters and digits only, it goes into a URL.
# One way to make one: openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional.
# CLAUDE_MODEL=claude-haiku-4-5
# CLAUDE_TIMEOUT_SECONDS=60.0
# DATABASE_URL=sqlite+aiosqlite:///./chapter_and_verse.db
