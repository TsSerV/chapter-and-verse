{
  "uid": "vllm", "title": "vLLM", "schemaVersion": 41, "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "title": "Requests in vLLM", "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "running",
         "expr": "sum(vllm:num_requests_running{job=\"kubernetes-pods\"})"},
        {"refId": "B", "legendFormat": "waiting",
         "expr": "sum(vllm:num_requests_waiting{job=\"kubernetes-pods\"})"}
      ]
    },
    {
      "title": "KV cache used", "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "largest pod",
         "expr": "max(vllm:kv_cache_usage_perc{job=\"kubernetes-pods\"})"}
      ]
    },
    {
      "title": "Time to first token", "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "p50",
         "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{job=\"kubernetes-pods\"}[1m])))"},
        {"refId": "B", "legendFormat": "p95",
         "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{job=\"kubernetes-pods\"}[1m])))"}
      ]
    },
    {
      "title": "Time per output token", "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "p50",
         "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:request_time_per_output_token_seconds_bucket{job=\"kubernetes-pods\"}[1m])))"},
        {"refId": "B", "legendFormat": "p95",
         "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:request_time_per_output_token_seconds_bucket{job=\"kubernetes-pods\"}[1m])))"}
      ]
    },
    {
      "title": "Output tokens per second", "type": "timeseries",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "all pods",
         "expr": "sum(rate(vllm:generation_tokens_total{job=\"kubernetes-pods\"}[1m]))"}
      ]
    },
    {
      "title": "Time waiting in the queue", "type": "timeseries",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "p95",
         "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:request_queue_time_seconds_bucket{job=\"kubernetes-pods\"}[1m])))"}
      ]
    }
  ]
}
